{
  "name": "geo-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mcp:stdio": "node --experimental-strip-types mcp/stdio.ts",
    "mcp:http": "node --experimental-strip-types mcp/http.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/flow/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=commands/**/*.ts --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test tests/unit/*.test.ts tests/flow/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
